# ═══════════════════════════════════════════════════════════════════
#  Aegis-X — Production Environment Variables
#  !! DO NOT commit to git — use a secrets manager (Vault / K8s Secrets)
# ═══════════════════════════════════════════════════════════════════

APP_NAME="Aegis-X"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://exam.yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ── Logging ────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

# ── Database — ProxySQL endpoints ─────────────────────────────────
DB_CONNECTION=mysql
DB_WRITE_HOST=proxysql       # → ProxySQL → MySQL Master
DB_READ_HOST=proxysql        # → ProxySQL → MySQL Replica
DB_WRITE_PORT=6033
DB_READ_PORT=6033
DB_DATABASE=aegis_x
DB_USERNAME=aegis
DB_PASSWORD=aegispass

# ── Session — Redis (stateless for API, Redis for web admin) ───────
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Cache — Redis ──────────────────────────────────────────────────
CACHE_STORE=redis

# ── Queue — Redis (Horizon) ────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Redis Cluster ──────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_CLUSTER=redis
REDIS_HOST=redis-cluster        # K8s headless service DNS
REDIS_PASSWORD=aegisredis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Octane / Swoole ────────────────────────────────────────────────
OCTANE_SERVER=swoole
OCTANE_WORKERS=auto             # = CPU cores × 2
OCTANE_MAX_REQUESTS=500         # Recycle worker after 500 requests

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_TTL=120                     # 2 hours (matches exam max duration)
JWT_REFRESH_TTL=20160           # 2 weeks for refresh window

# ── Broadcast ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=redis

# ── Aegis AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_KEY
GEMINI_MODEL=gemini-2.5-flash
AEGIS_AI_ENABLED=true
AEGIS_OVERWATCH_ENABLED=true
AEGIS_VISION_ENABLED=true

# ── Filesystem ────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=aegis-x-prod

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=ses
