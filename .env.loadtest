APP_NAME="Aegis-X"
APP_ENV=production
APP_KEY=base64:bPEKKK3N3dX6crJnIJBP+RexEFoGEFsPpXDLj15qFDE=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# توجيه الـ logs لـ stderr فقط (لا كتابة على القرص)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# قاعدة بيانات مستقلة للاختبار
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aegis_x_loadtest
DB_USERNAME=root
DB_PASSWORD=

# Redis غير متاح على هذا الجهاز — نستخدم database driver
# (للإنتاج الحقيقي: استبدل بـ redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# BCRYPT rounds منخفضة للـ seeding السريع (نغيّرها بعد الـ seed)
BCRYPT_ROUNDS=4

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# ── إيقاف ميزات تتعارض مع k6 ──────────────────────────────
# منع Overwatch من حظر روبوتات k6 كـ attackers
AEGIS_OVERWATCH_ENABLED=false
AEGIS_AI_ENABLED=false
AEGIS_VISION_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
